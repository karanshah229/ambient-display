<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wake Me Up"
            android:textColor="#FF9F0A"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Automatic 7.5h Sleep &amp; Monitor Display Companion"
            android:textColor="#8E8E93"
            android:textSize="14sp" />

        <!-- Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#1C1C1E"
            app:cardCornerRadius="16dp"
            app:strokeColor="#2C2C2E"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvSleepStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status: Monitoring Lock Events"
                    android:textColor="#30D158"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvWakeTarget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Target: Standby"
                    android:textColor="#EBEBF5"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvDisplayTimeout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Live Display Sleep Timeout: 30 mins"
                    android:textColor="#8E8E93"
                    android:textSize="12sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Mac Server Connection Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#1C1C1E"
            app:cardCornerRadius="16dp"
            app:strokeColor="#2C2C2E"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MacBook Air Server"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Mac IP Address (e.g. 192.168.1.3)"
                    app:boxBackgroundColor="#2C2C2E"
                    app:boxCornerRadiusBottomEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusTopStart="8dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMacHost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:textColor="#FFFFFF" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSaveHost"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:backgroundTint="#2C2C2E"
                        android:text="Save IP"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnTestConnection"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:backgroundTint="#FF9F0A"
                        android:text="Test Ping"
                        android:textColor="#000000" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnAutoDiscover"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#0A84FF"
                    android:text="🔍 Auto-Discover Mac (mDNS / Scan)"
                    android:textColor="#FFFFFF" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Actions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Actions &amp; Overrides"
            android:textColor="#8E8E93"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnManualSleep"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#30D158"
            android:text="Start Sleep Now (Manual 7.5h)"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTestMode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#2C2C2E"
            android:text="Preview Display (10s Test Mode)"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnStopSleep"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#3A1C1C"
            android:text="Stop Sleep / I'm Awake"
            android:textColor="#FF453A" />

        <!-- OnePlus Setup Checklist -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="OnePlus / OxygenOS Setup Checklist"
            android:textColor="#FF9F0A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnBatteryOpt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#2C2C2E"
            android:text="1. Disable Battery Optimization"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnUsageAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:backgroundTint="#2C2C2E"
            android:text="2. Grant Usage Access (Inactivity Check)"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:backgroundTint="#2C2C2E"
            android:text="3. Enable Watchdog (Accessibility)"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnAutoLaunch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:backgroundTint="#2C2C2E"
            android:text="4. OnePlus Auto-Launch Manager"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
