<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms is used only for the tray NotifyIcon until the M3 tray rewrite. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>AmbientDisplay</AssemblyName>
    <RootNamespace>AmbientDisplay.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- DPI awareness belongs in app.manifest for a WPF-hosted process; the WinForms analyzer assumes a WinForms app. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avoid WPF/WinForms type-name clashes (Application, MessageBox, Color, ...). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AmbientDisplay.Core\AmbientDisplay.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

</Project>
