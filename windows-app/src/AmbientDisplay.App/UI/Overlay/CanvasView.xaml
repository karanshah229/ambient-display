<UserControl x:Class="AmbientDisplay.App.UI.Overlay.CanvasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Black"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Grayscale">
    <!-- Port of macOS CanvasOverlayView.swift: billboard, sunrise, image, video and web canvases. -->
    <Grid>
        <!-- Background media layer (image / video) with a vignette so overlaid text stays readable. -->
        <Grid x:Name="MediaLayer" />
        <Rectangle x:Name="Vignette" Visibility="Collapsed" IsHitTestVisible="False" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top status bar -->
            <DockPanel Grid.Row="0" Margin="48,36,48,0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TypeIcon" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="HeaderTitle" FontFamily="{StaticResource MonoFont}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock x:Name="HeaderSeparator" Text="•" Margin="8,0" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock x:Name="HeaderDetail" FontFamily="{StaticResource MonoFont}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="LockedBadge" CornerRadius="6" Padding="10,4" Margin="0,0,8,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="LockIcon" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="LOCKED" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="TimerBadge" CornerRadius="6" Padding="10,4" Margin="0,0,8,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TimerIcon" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TimerText" FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="TimeText" FontFamily="{StaticResource MonoFont}" FontSize="16" FontWeight="Medium" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>

            <!-- Centre: headline + subtitle (billboard, sunrise, image, video) -->
            <StackPanel x:Name="TextPanel" Grid.Row="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Margin="64,0" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold"
                           TextAlignment="Center" TextWrapping="Wrap" LineStackingStrategy="BlockLineHeight" />
                <TextBlock x:Name="SubtitleText" Margin="80,16,80,0" FontFamily="{StaticResource DisplayFont}"
                           TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Centre: web dashboard. Kept between the bars (not under them) because WebView2 is an HWND
                 and WPF cannot draw on top of it. -->
            <Border x:Name="WebHost" Grid.Row="1" Margin="24,20,24,20" CornerRadius="8" ClipToBounds="True" Visibility="Collapsed" />

            <!-- Footer -->
            <DockPanel Grid.Row="2" Margin="48,0,48,36" LastChildFill="False">
                <Button x:Name="DismissButton" DockPanel.Dock="Left" Style="{StaticResource OverlayButton}" Tag="6" Padding="16,6" Click="OnDismissClicked">
                    <TextBlock x:Name="DismissText" Text="Dismiss" FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="Medium" />
                </Button>
                <StackPanel x:Name="PhoneOnlyHint" DockPanel.Dock="Left" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock x:Name="PhoneIcon" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Dismiss from Ambient Display on your phone" FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="HintText" DockPanel.Dock="Right" Text="Press ESC or click anywhere to dismiss" FontFamily="{StaticResource DisplayFont}" FontSize="14" VerticalAlignment="Center" />
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
